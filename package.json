{
  "name": "reading-list-auto-summary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "build:release": "vite build && cd dist && zip -r ../readling-list-auto-summary.zip .",
    "preview": "vite preview",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "biome:ci": "biome ci .",
    "test": "vitest --silent",
    "test:ci": "vitest --silent --run --coverage",
    "e2e": "playwright test",
    "e2e:build": "pnpm build && playwright test",
    "check:ai": "pnpm type-check && pnpm biome:fix && pnpm test --run --reporter=dot && pnpm build"
  },
  "author": "kesin1202000@gmail.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.4",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@mizchi/readability": "^0.7.7",
    "openai": "^7.51.0",
    "preact": "^11.1.1",
    "unpdf": "^2.1.0"
  }
}
